# Copier en /opt/hanyu/.env sur le VPS (chmod 600). Ne jamais committer le vrai .env.
DOMAIN=hanyu.medevstack.com
# Généré sur le VPS : openssl rand -hex 32
POSTGRES_PASSWORD=a-generer-sur-le-vps
# Clé de signature des sessions, générée sur le VPS : openssl rand -hex 48
JWT_SECRET=a-generer-sur-le-vps
# Version des images à lancer (le déploiement automatique fixe le commit exact)
IMAGE_TAG=latest
